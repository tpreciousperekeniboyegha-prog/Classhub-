<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ClassHub - School Portal</title>
<style>
body{font-family:Arial;background:#0f2a5a;color:white;text-align:center;padding:20px}
.box{background:white;color:#222;max-width:380px;margin:20px auto;padding:20px;border-radius:15px}
input,select,button{width:100%;padding:12px;margin:8px 0;border-radius:8px;border:1px solid #ccc;font-size:16px}
button{background:#f5b301;border:none;font-weight:bold}
h1{font-size:30px} p{color:#ddd}
</style>
</head>
<body>
<h1>🎓 ClassHub</h1>
<p>Learn • Connect • Grow</p>
<div class="box">
<h2>Login to Portal</h2>
<select id="role"><option>Admin</option><option>Teacher</option><option>Student</option></select>
<input placeholder="Username / Email">
<input type="password" placeholder="Password">
<button onclick="login()">Login</button>
<p style="color:#666;font-size:13px">Demo: Admin / admin123<br>Teacher / teach123<br>Student / student123</p>
</div>
<script>
function login(){
let r=document.getElementById('role').value;
if(r=='Admin') location.href='admin.html';
if(r=='Teacher') location.href='teacher.html';
if(r=='Student') location.href='student.html';
}
</script>
</body>
</html>
